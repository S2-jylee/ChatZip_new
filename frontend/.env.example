# 복사해서 .env 로 만든 뒤 값을 채우세요. (.env 는 GitHub에 올리지 않습니다)
# 백엔드 주소. 비워 두면 Vite 프록시를 거쳐 VITE_PROXY_TARGET 으로 요청 (개발 중 CORS 없이)
VITE_API_URL=
VITE_PROXY_TARGET=http://192.168.0.30:8080
# MOCK 이어도 실서버로 부를 기능 (쉼표로): estates = 지도·매물찾기·상세(아파트 매매), stats = 지역별분석
VITE_LIVE_API=estates,stats
# 카카오 개발자 콘솔 > JavaScript 키 (플랫폼 > Web 에 http://localhost:5173 등록 필수)
VITE_KAKAO_MAP_KEY=
# 백엔드/AI 서버 없이 화면 개발할 때 true
VITE_USE_MOCK=true
